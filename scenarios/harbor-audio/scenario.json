{
  "description": "liquidsoap encodes one playlist and serves every listener itself through output.harbor.",
  "processes": [
    {
      "name": "liquidsoap",
      "server": true,
      "prepare": [
        [
          "${LIQUIDSOAP}",
          "--cache-only",
          "main.liq"
        ]
      ],
      "cmd": [
        "${LIQUIDSOAP}",
        "main.liq"
      ]
    }
  ],
  "mounts": [
    {
      "path": "/mp3",
      "content_type": "audio/mpeg",
      "nominal_kbps": 128,
      "when": "MP3"
    },
    {
      "path": "/opus",
      "content_type": "application/ogg",
      "nominal_kbps": 96,
      "when": "OPUS"
    },
    {
      "path": "/flac",
      "content_type": "application/ogg",
      "when": "FLAC"
    }
  ]
}
