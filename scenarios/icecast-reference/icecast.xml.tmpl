<icecast>
  <location>icetest</location>
  <admin>icetest@localhost</admin>
  <limits>
    <clients>100000</clients>
    <sources>10</sources>
    <queue-size>524288</queue-size>
    <client-timeout>30</client-timeout>
    <header-timeout>15</header-timeout>
    <source-timeout>10</source-timeout>
    <burst-on-connect>1</burst-on-connect>
    <burst-size>65535</burst-size>
  </limits>
  <authentication>
    <source-password>hackme</source-password>
    <relay-password>hackme</relay-password>
    <admin-user>admin</admin-user>
    <admin-password>hackme</admin-password>
  </authentication>
  <hostname>localhost</hostname>
  <listen-socket>
    <port>${PORT}</port>
  </listen-socket>
  <fileserve>0</fileserve>
  <paths>
    <basedir>${RUN_DIR}</basedir>
    <logdir>${RUN_DIR}</logdir>
    <!-- Fedora layout; Debian ships them under /usr/share/icecast2. -->
    <webroot>/usr/share/icecast/web</webroot>
    <adminroot>/usr/share/icecast/admin</adminroot>
  </paths>
  <logging>
    <accesslog>icecast-access.log</accesslog>
    <errorlog>-</errorlog>
    <loglevel>2</loglevel>
    <logsize>100000</logsize>
  </logging>
  <security>
    <chroot>0</chroot>
  </security>
</icecast>
