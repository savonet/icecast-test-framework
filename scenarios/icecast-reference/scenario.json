{
  "description": "Reference point: the same liquidsoap encoder pushes the stream with output.icecast into Icecast 2.4.4, the Debian 13 package with its client limit raised to 250000, on the same box; Icecast serves the listeners.",
  "templates": [
    "icecast.xml.tmpl"
  ],
  "alert_patterns": [
    "EROR",
    "Client limit",
    "Too many open files"
  ],
  "processes": [
    {
      "name": "icecast",
      "server": true,
      "cmd": [
        "icecast",
        "-c",
        "${RUN_DIR}/icecast.xml"
      ]
    },
    {
      "name": "liquidsoap",
      "prepare": [
        [
          "${LIQUIDSOAP}",
          "--cache-only",
          "feed.liq"
        ]
      ],
      "cmd": [
        "${LIQUIDSOAP}",
        "feed.liq"
      ]
    }
  ],
  "mounts": [
    {
      "path": "/mp3",
      "content_type": "audio/mpeg",
      "nominal_kbps": 128,
      "when": "MP3"
    },
    {
      "path": "/opus",
      "content_type": "application/ogg",
      "nominal_kbps": 96,
      "when": "OPUS"
    },
    {
      "path": "/flac",
      "content_type": "application/ogg",
      "when": "FLAC"
    }
  ]
}
